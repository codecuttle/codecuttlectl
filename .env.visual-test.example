# Environment variables for visual testing.
# Copy this to .env.visual-test and fill in values.
#
# AWS credentials (for Bedrock model calls during visual tests):
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Or use instance role / ECS task role (no vars needed if running on AWS)
#
# GitHub token (optional, for github plugin tests):
# GITHUB_TOKEN=
#
# Exa API key (optional, for web search tests):
# EXA_API_KEY=
